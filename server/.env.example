# Server runtime
NODE_ENV=development
PORT=4000

# MongoDB connection string. Use a dedicated, least-privilege database user.
MONGODB_URI=mongodb://127.0.0.1:27017/codetogether

# Comma-separated list of trusted browser origins. No wildcards.
CORS_ORIGINS=http://localhost:5173

# Minimum 32 characters. Generate a unique value for every environment.
SESSION_SECRET=replace-this-with-a-unique-session-secret-of-at-least-32-chars

# lax, strict, or none. "none" requires production Secure cookies.
COOKIE_SAME_SITE=lax

# Set true only when a trusted TLS-terminating proxy is in front of the API.
TRUST_PROXY=false
